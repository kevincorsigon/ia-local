# Cloud Providers Configuration
LLM_MODE=auto
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Em modo auto, usa Ollama primeiro; após este limite tenta cloud.
AUTO_OLLAMA_TIMEOUT_SECONDS=10


OLLAMA_MODEL=qwen2.5:1.5b
# Tempo que o Ollama mantém o modelo carregado depois da última mensagem. Evita
# pagar o carregamento (~6 s na GPU) na primeira pergunta após uma pausa.
OLLAMA_KEEP_ALIVE=30m
# ------------------------------------------------------------------ Tuning LLM
# Por requisição (options.* do /api/chat, via backend):
# NUM_CTX = janela de contexto. 8192 na GPU é rápido e sobra para histórico +
# ferramenta; na CPU use 2048 (32768, o default do Qwen, é lento no prefill).
OLLAMA_NUM_CTX=2048
# NUM_THREAD = threads por requisição. 0 = o Ollama decide (ideal na GPU).
# Na CPU fixe em nproc-2 para sobrar para Whisper/Piper.
OLLAMA_NUM_THREAD=0
# NUM_BATCH = lote de avaliação. 1024 acelera a GPU; 256 economiza RAM na CPU.
OLLAMA_NUM_BATCH=512
# TEMPERATURE 0 = determinístico e levemente mais rápido (menos amostragem).
OLLAMA_TEMPERATURE=0
OLLAMA_REPEAT_PENALTY=1.0
# Servidor (usado pelos scripts ao subir o 'ollama serve' no WSL/NUC):
# FLASH_ATTENTION=1 acelera e economiza memória (recomendado sempre).
# KV_CACHE_TYPE: f16 na GPU (máx. qualidade, VRAM sobrando); q8_0 na CPU
# (metade da RAM do KV-cache, perda mínima). Vazio = default do Ollama.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=
# Paralelismo do servidor: 1 = uma resposta por vez, sem dividir GPU/CPU.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MAX_QUEUE=512
# Contexto default do servidor (o backend manda num_ctx por requisição).
OLLAMA_CONTEXT_LENGTH=2048
# Reserva usada quando a URL principal não responde (preenchida pelo bootstrap com a
# outra instância: WSL quando o Windows assume e vice-versa).
OLLAMA_FALLBACK_URL=
# Política de Ollama: prefere o do host Windows (usa a GPU, ~6x mais rápido que a CPU
# do WSL). Se ele não estiver acessível, o bootstrap sobe e usa o do WSL. Use 0 para
# ignorar o Windows e trabalhar sempre com o do WSL.
OLLAMA_PREFER_WINDOWS=1
# IP do host Windows visto pelo WSL. Vazio = detectar pelo gateway padrão (recomendado).
OLLAMA_WINDOWS_HOST=
OLLAMA_PORT=11434
# Motor de reconhecimento de fala: 'whisper', 'vosk' (local) ou 'groq' (cloud).
# O Vosk roda em qualquer CPU e é 100% offline, mas erra muito em fala espontânea; o
# Whisper é mais pesado e baixa o modelo na primeira vez (fica no volume persistente).
STT_ENGINE=whisper
# Quando STT_ENGINE=groq, envia o áudio ao backend da Groq; exige GROQ_API_KEY.
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_TIMEOUT_SECONDS=20
# Modelo do Whisper: tiny | base | small (recomendado) | medium | large-v3.
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
# Núcleos dedicados ao Whisper (0 = todos). Em CPU fraca (NUC de 4 núcleos, por exemplo) vale
# deixar 2 para o modelo de linguagem e o Kokoro continuarem respondendo.
WHISPER_CPU_THREADS=0
# Feixes da busca do decoder (1 = guloso/rápido; 5 = padrão do Whisper, bem mais preciso).
WHISPER_BEAM_SIZE=5
# Opcional: frase/texto que enviesa o reconhecedor (nomes próprios, jargão). Vazio = o backend
# usa o nome e as alcunhas do config/assistant.yaml.
WHISPER_INITIAL_PROMPT=
# Modelo de reconhecimento de fala (Vosk pt-BR), usado quando STT_ENGINE=vosk. O pequeno tem
# 31 MB e roda em qualquer máquina; o grande tem 1,6 GB (licença GPLv3) e erra bem menos.
VOSK_MODEL_NAME=vosk-model-small-pt-0.3
# URL vista pelo WSL e pelos scripts (modo WSL).
OLLAMA_HOST_URL=http://127.0.0.1:11434
# URL vista pelos containers. O bootstrap sobrescreve conforme o modo escolhido:
#   Windows -> http://<gateway-do-WSL>:11434   |   WSL -> http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Interface em que o bootstrap inicia o 'ollama serve' quando precisa subi-lo.
# 0.0.0.0 permite que os containers cheguem ao host; restrinja a porta 11434 com firewall.
OLLAMA_SERVE_HOST=0.0.0.0
# Store de modelos usado ao iniciar o Ollama pelo bootstrap. Vazio = padrão da distribuição.
# No WSL, aponte para o store do Windows (ex.: /mnt/c/Users/SEU_USUARIO/.ollama/models) para reaproveitar modelos.
OLLAMA_MODELS_DIR=
CHAT_TIMEOUT_SECONDS=180
MAX_MESSAGE_CHARS=4000
MAX_RESPONSE_TOKENS=400
# Desliga o thinking (Gemma 4, Qwen3...) por padrão: sem think=false o raciocínio
# consome o num_predict e o content volta vazio (aumentar 400 -> 1200 não adianta).
OLLAMA_THINK=false
# Quantidade máxima de informações guardadas no volume Docker (assistente-local-data).
# O volume é criado pelo Compose e sobrevive a 'down'/'up'; limpe com:
# docker compose --env-file .env --profile core --profile voice down -v
MAX_MEMORIES=200
WEB_PORT=8080

# Token Brave Search: necessário para perguntas sobre notícias/esportes/dados atuais.
# Mantenha vazio até configurar uma chave no painel do provedor.
BRAVE_SEARCH_API_KEY=

# Vazio usa a voz padrão do motor: pf_dora no Kokoro ou dii no Piper.
TTS_VOICE=
# Motor de síntese: 'kokoro' (imagem ~1,5 GB, voz feminina pf_dora) ou 'piper'
# (build local ~400-600 MB, voz feminina dii). O backend resolve TTS_URL e a voz
# padrão a partir do motor, salvo override manual de TTS_URL/TTS_VOICE.
# Trocar exige os scripts subirem o profile correspondente: use
# tts_profile() nos scripts (--profile tts-kokoro / tts-piper) ou rode o bootstrap.
TTS_ENGINE=kokoro
# Voz do Piper (pt-BR, feminina) usada quando TTS_ENGINE=piper.
PIPER_VOICE=dii
# Threads do ONNX no Piper. Em CPU fraca (NUC de 4 núcleos) o Whisper, o Ollama e o
# TTS disputam os mesmos núcleos — 2 threads economizam latência do resto do ciclo.
PIPER_THREADS=2
# Imagem do Kokoro (TTS local). Padrão: Kokoro-FastAPI CPU, ~1,5 GB, com modelo e
# vozes embutidos. Alternativas medidas, caso o ghcr esteja lento:
#   ghcr.io/openttsgroup/kokoro-open-tts:latest   (~15 GB, base CUDA; exige GPU)
#   turbomlinc/kokoro-fastapi:auto8-cpu           (Docker Hub, ~3 GB)
TTS_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:latest
# 1 = o autostart abre o Chromium/Chrome em modo quiosque (tela cheia de
# verdade, sem bordas). 0 = abre o navegador padrão em janela normal. Exige
# Chromium/Chrome instalado; sem ele, cai para o navegador padrão.
ASSISTANT_KIOSK=0
